# Direct Anthropic access (not needed when using LLM_BASE_URL + LLM_API_KEY)
# ANTHROPIC_API_KEY=
# Where the database, profile docs and tokens live
DATA_DIR=./data
PORT=4410
# AI connection — easiest is the "AI connection" panel on Plume's website list. Or set it here:
# LLM_BASE_URL=https://litellm.yourcompany.com   (leave out to use Anthropic directly)
# LLM_API_KEY=
# LLM_HEADERS=
# Optional: override which model does each job
# PLUME_MODEL_RESEARCH=claude-opus-5-5
# PLUME_MODEL_DRAFT=claude-sonnet-5-5
# PLUME_MODEL_SCORE=claude-haiku-5-5
# Web search when model calls go through a proxy (https://tavily.com)
# TAVILY_API_KEY=
# Site speed checks (free key from Google Cloud; without it you share Google's small daily limit)
# PAGESPEED_API_KEY=
